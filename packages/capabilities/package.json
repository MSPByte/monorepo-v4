{
  "name": "@mspbyte/capabilities",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "import:openapi": "bun run scripts/import-openapi.ts",
    "review:openapi": "bun run scripts/review-openapi-candidate.ts",
    "scaffold:openapi": "bun run scripts/scaffold-openapi-capability.ts"
  },
  "dependencies": {
    "@mspbyte/connectors": "*",
    "@mspbyte/shared": "*",
    "js-yaml": "^5.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mspbyte/typescript-config": "*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "typescript": "^5.4.0"
  }
}
